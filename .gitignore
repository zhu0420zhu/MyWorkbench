# Dependencies
node_modules/

# Build output
dist/
out/
release/

# App icons live in build/ and are REQUIRED by the electron-builder config
# (win.icon / nsis.installerIcon -> build/icon.ico, extraResources -> build/icon.png),
# so ignore the directory contents but keep the two icons tracked.
build/*
!build/icon.ico
!build/icon.png

# Logs
*.log
npm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
*.swp

# Env
.env
.env.local

# SQLite / runtime data (generated at runtime)
*.db
*.sqlite
userData/

# Generated temp config (electron-vite temp copies)
electron.vite.config.*.mjs

# Local tooling / caches
.dl/
.toolcache/
.workbuddy/
smoke_st/

# Legacy / external assets (not part of lingmo-workbench source)
ck/
design/
resources/
vendor/

# Packaging / build caches
.electron-builder-cache/
*.tsbuildinfo

# Local runtime logs
logs/

# SillyTavern runtime config (template with placeholder credential fields;
# byte-identical to vendor/SillyTavern/config.yaml). Regenerated locally on demand.
config.yaml

# Root bundled artifact (generated, do not track)
index.js
